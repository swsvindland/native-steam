<Project>
  <!--
    WinUI 3 + a self-contained Windows App SDK need a concrete architecture. Default to x64 so a plain
    `dotnet build` / `dotnet run` works; pass -p:Platform=ARM64 (or pick it in Visual Studio) for Arm64.
  -->
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>
</Project>
