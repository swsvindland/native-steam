<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NativeSteam.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NativeSteam.Controls"
    xmlns:vm="using:NativeSteam.ViewModels"
    NavigationCacheMode="Required"
    Foreground="{StaticResource TextBodyBrush}">

    <Page.Resources>
        <DataTemplate x:Key="StatTemplate" x:DataType="vm:StatVM">
            <StackPanel Padding="0,4,0,4" Spacing="2">
                <TextBlock Text="{x:Bind Value}" Style="{StaticResource StatValueTextStyle}" />
                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BadgeTemplate" x:DataType="vm:BadgeVM">
            <StackPanel Spacing="8" ToolTipService.ToolTip="{x:Bind Description}">
                <Grid Width="60" Height="60" HorizontalAlignment="Center">
                    <Ellipse Fill="{x:Bind Fill}" />
                    <Ellipse Margin="4" Stroke="#40FFFFFF" StrokeThickness="1.5" />
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Foreground="White" />
                    <Border Padding="5,0,5,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="8" Background="#FF171A21" BorderBrush="{x:Bind Fill}" BorderThickness="1.5">
                        <TextBlock Text="{x:Bind Level}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Grid>
                <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{StaticResource TextBodyBrush}" TextAlignment="Center" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RecentGameTemplate" x:DataType="vm:RecentGameVM">
            <controls:CardButton HorizontalAlignment="Stretch" Click="OnRecentGameClick" Background="{StaticResource SurfaceNeutralBrush}" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="{x:Bind Name}">
                <Grid ColumnSpacing="16" Padding="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:ArtImage Width="196" Height="92" Url="{x:Bind Header}" PlaceholderText="{x:Bind Name}" CornerRadius="6,0,0,6" DecodeWidth="392" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                        <StackPanel Spacing="4" Visibility="{x:Bind AchievementVisibility}">
                            <TextBlock Text="{x:Bind AchievementLabel}" Style="{StaticResource MetaTextStyle}" />
                            <ProgressBar MaxWidth="320" HorizontalAlignment="Stretch" Style="{StaticResource SteamProgressBarStyle}" Value="{x:Bind AchievementPercent}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind TotalLabel}" FontSize="13" Foreground="{StaticResource TextBodyBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind LastPlayedLabel}" Style="{StaticResource MetaTextStyle}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </controls:CardButton>
        </DataTemplate>

        <DataTemplate x:Key="RareAchievementTemplate" x:DataType="vm:ShowcaseAchievementVM">
            <controls:CardButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="10" Click="OnRareAchievementClick" Background="{StaticResource SurfaceNeutralBrush}" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="{x:Bind Name}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:ArtImage Width="56" Height="56" Url="{x:Bind Icon}" CornerRadius="4" DecodeWidth="112" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextTitleBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind AppName}" Style="{StaticResource MetaTextStyle}" />
                        <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </controls:CardButton>
        </DataTemplate>

        <DataTemplate x:Key="FriendAvatarTemplate" x:DataType="vm:FriendVM">
            <controls:CardButton Width="56" Height="56" Padding="0" CornerRadius="4" Background="Transparent" Click="OnFriendClick" Style="{StaticResource CardButtonStyle}" ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}">
                <Border CornerRadius="4" BorderThickness="2" BorderBrush="{x:Bind StatusBrush}">
                    <controls:ArtImage Url="{x:Bind Avatar}" CornerRadius="2" DecodeWidth="112" Opacity="{x:Bind AvatarOpacity}" />
                </Border>
            </controls:CardButton>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource LibraryBackgroundBrush}">
        <ScrollViewer x:Name="PageScroller" Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel XYFocusKeyboardNavigation="Enabled">

                <!-- 1. Banner -->
                <Grid x:Name="Banner" Height="320">
                    <controls:ArtImage Url="{x:Bind User.BackgroundUrl}" ShowPlaceholder="False" Opacity="0.7" DecodeWidth="1920" />
                    <Border Background="{StaticResource ProfileBannerFadeBrush}" />
                    <Grid x:Name="BannerContent" MaxWidth="1600" Padding="40,0,40,28" VerticalAlignment="Bottom" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="AvatarFrame" Width="140" Height="140" CornerRadius="4" BorderThickness="3" BorderBrush="{StaticResource StatusOnlineBrush}" VerticalAlignment="Bottom">
                            <controls:ArtImage Url="{x:Bind User.AvatarUrl}" CornerRadius="2" DecodeWidth="280" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                            <TextBlock Text="{x:Bind User.PersonaName}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource TextTitleBrush}" />
                            <TextBlock FontSize="14" Foreground="{StaticResource TextBodyBrush}">
                                <Run Text="{x:Bind User.RealName}" />
                                <Run Text=" · " Foreground="{StaticResource TextMutedBrush}" />
                                <Run Text="{x:Bind User.Country}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource StatusOnlineBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Online" FontSize="13" Foreground="{StaticResource StatusOnlineBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="LevelPanel" Grid.Column="2" VerticalAlignment="Bottom" Spacing="10" MinWidth="240">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Level" FontSize="20" Foreground="{StaticResource TextTitleBrush}" VerticalAlignment="Center" />
                                <Grid Width="44" Height="44">
                                    <Ellipse Stroke="{x:Bind LevelBrush}" StrokeThickness="3" />
                                    <TextBlock Text="{x:Bind LevelText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextTitleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind User.XpToNextLabel}" Style="{StaticResource MetaTextStyle}" />
                                <ProgressBar Style="{StaticResource SteamProgressBarStyle}" Value="{x:Bind XpPercent}" />
                            </StackPanel>
                            <Button x:Name="EditProfileButton" Style="{StaticResource SecondaryActionButtonStyle}" MinHeight="36" Click="OnEditProfileClick" AutomationProperties.Name="Edit Profile">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                    <TextBlock x:Name="EditProfileLabel" Text="Edit Profile" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Body -->
                <Grid x:Name="BodyGrid" MaxWidth="1600" Padding="40,8,40,48" ColumnSpacing="40" RowSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SideColumn" Width="360" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 3. Stats row -->
                    <Border Grid.ColumnSpan="2" Padding="24,14,24,14" CornerRadius="6" Background="#66171A21" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                        <ItemsRepeater ItemsSource="{x:Bind Stats}" ItemTemplate="{StaticResource StatTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="118" MinItemHeight="56" MinColumnSpacing="12" MinRowSpacing="12" MaximumRowsOrColumns="7" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Border>

                    <!-- Main showcases -->
                    <StackPanel x:Name="MainColumn" Grid.Row="1" Spacing="32">

                        <!-- 5. Favorite game -->
                        <StackPanel Spacing="12" Visibility="{x:Bind FavoriteVisibility}">
                            <controls:SectionHeader Title="Favorite Game" />
                            <controls:CardButton x:Name="FavoriteCard" HorizontalAlignment="Stretch" Click="OnFavoriteClick" Background="{StaticResource SurfaceNeutralBrush}" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="{x:Bind FavoriteName}">
                                <Grid Height="250">
                                    <controls:ArtImage Url="{x:Bind FavoriteHero}" PlaceholderText="{x:Bind FavoriteName}" CornerRadius="6" DecodeWidth="1400" />
                                    <Border Background="{StaticResource CardScrimBrush}" CornerRadius="6" />
                                    <controls:ArtImage Height="96"
                                                       Margin="24,0,260,22"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Bottom"
                                                       Url="{x:Bind FavoriteLogo}"
                                                       Stretch="Uniform"
                                                       ImageAlignmentX="Left"
                                                       ImageAlignmentY="Bottom"
                                                       ShowPlaceholder="False"
                                                       DecodeWidth="760" />
                                    <StackPanel Margin="24,0,24,22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="6" MinWidth="200">
                                        <TextBlock Text="{x:Bind FavoriteHours}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextTitleBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind FavoriteAchievements}" Style="{StaticResource MetaTextStyle}" Foreground="{StaticResource TextBodyBrush}" HorizontalAlignment="Right" />
                                        <ProgressBar Style="{StaticResource SteamProgressBarStyle}" Value="{x:Bind FavoritePercent}" />
                                    </StackPanel>
                                </Grid>
                            </controls:CardButton>
                        </StackPanel>

                        <!-- 6. Recent activity -->
                        <StackPanel Spacing="12">
                            <controls:SectionHeader Title="Recent Activity" Trailing="{x:Bind RecentHoursLabel}" />
                            <ItemsControl ItemsSource="{x:Bind RecentGames}" ItemTemplate="{StaticResource RecentGameTemplate}" Style="{StaticResource StackListStyle}" />
                        </StackPanel>

                        <!-- 8. Screenshot showcase: one large + three small -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ScreenshotsVisibility}">
                            <controls:SectionHeader Title="Screenshot Showcase" Trailing="{x:Bind ScreenshotsCount}" />
                            <Grid x:Name="ScreenshotGrid" ColumnSpacing="10" RowSpacing="10" Height="390">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <controls:CardButton x:Name="Shot0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnShowcaseScreenshotClick" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="Screenshot">
                                    <controls:ArtImage x:Name="Shot0Image" CornerRadius="6" DecodeWidth="1100" />
                                </controls:CardButton>
                                <controls:CardButton x:Name="Shot1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnShowcaseScreenshotClick" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="Screenshot">
                                    <controls:ArtImage x:Name="Shot1Image" CornerRadius="6" DecodeWidth="520" />
                                </controls:CardButton>
                                <controls:CardButton x:Name="Shot2" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnShowcaseScreenshotClick" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="Screenshot">
                                    <controls:ArtImage x:Name="Shot2Image" CornerRadius="6" DecodeWidth="520" />
                                </controls:CardButton>
                                <controls:CardButton x:Name="Shot3" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnShowcaseScreenshotClick" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="Screenshot">
                                    <controls:ArtImage x:Name="Shot3Image" CornerRadius="6" DecodeWidth="520" />
                                </controls:CardButton>
                            </Grid>
                        </StackPanel>

                        <!-- 7. Rare achievement showcase -->
                        <StackPanel Spacing="12">
                            <controls:SectionHeader Title="Rare Achievement Showcase" />
                            <ItemsRepeater ItemsSource="{x:Bind RareAchievements}" ItemTemplate="{StaticResource RareAchievementTemplate}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="250" MinItemHeight="76" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>

                    <!-- Side column -->
                    <StackPanel x:Name="SideColumnPanel" Grid.Row="1" Grid.Column="1" Spacing="32">

                        <!-- 2. Summary -->
                        <StackPanel Padding="18" Spacing="10" CornerRadius="6" Background="#66171A21" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                            <TextBlock Text="{x:Bind User.Summary}" Style="{StaticResource BodyTextStyle}" />
                            <Border Height="1" Background="{StaticResource DividerBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind User.MemberSinceLabel}" Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="#FFC7A64B" />
                                <TextBlock Text="{x:Bind User.YearsLabel}" Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 4. Badges -->
                        <StackPanel Spacing="14">
                            <controls:SectionHeader Title="Badges" Trailing="{x:Bind BadgesCount}" />
                            <ItemsRepeater ItemsSource="{x:Bind Badges}" ItemTemplate="{StaticResource BadgeTemplate}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="100" MinItemHeight="104" MinColumnSpacing="8" MinRowSpacing="14" ItemsStretch="Fill" MaximumRowsOrColumns="3" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- 9. Friends -->
                        <StackPanel Spacing="12">
                            <controls:SectionHeader Title="Friends" Trailing="{x:Bind FriendsCount}" />
                            <ItemsRepeater ItemsSource="{x:Bind TopFriends}" ItemTemplate="{StaticResource FriendAvatarTemplate}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="56" MinItemHeight="56" MinColumnSpacing="10" MinRowSpacing="10" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Button Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Padding="8,0,8,0" Click="OnAllFriendsClick" AutomationProperties.Name="View all friends">
                                <TextBlock Text="View all friends ›" FontSize="13" Foreground="{StaticResource AccentLinkBrush}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
