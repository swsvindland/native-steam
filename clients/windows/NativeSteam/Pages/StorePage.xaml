<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NativeSteam.Pages.StorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NativeSteam.Controls"
    xmlns:vm="using:NativeSteam.ViewModels"
    NavigationCacheMode="Required"
    Foreground="{StaticResource TextBodyBrush}">

    <Page.Resources>

        <DataTemplate x:Key="GenreChipTemplate" x:DataType="vm:TextChipVM">
            <Border Padding="10,3,10,4" CornerRadius="11" Background="#1FFFFFFF">
                <TextBlock Text="{x:Bind Text}" FontSize="12" Foreground="{StaticResource TextBodyBrush}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TagChipTemplate" x:DataType="vm:TagVM">
            <Button Style="{StaticResource ChipButtonStyle}" Content="{x:Bind Name}" Click="OnTagClick" />
        </DataTemplate>

        <!-- FEATURED & RECOMMENDED, regular: capsule (62%) + detail panel. -->
        <DataTemplate x:Key="HeroWideTemplate" x:DataType="vm:StoreItemVM">
            <Grid CornerRadius="6" Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62*" />
                    <ColumnDefinition Width="38*" />
                </Grid.ColumnDefinitions>
                <controls:ArtImage Url="{x:Bind Capsule}" PlaceholderText="{x:Bind Name}" DecodeWidth="1100" />
                <Grid Grid.Column="1" Padding="22,18,22,18" RowSpacing="12" Background="#FF0F1A26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Name}"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextTitleBrush}"
                               TextWrapping="WrapWholeWords"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2" />
                    <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:ArtImage Grid.Row="0" Grid.Column="0" Url="{x:Bind Thumb1}" CornerRadius="3" DecodeWidth="320" />
                        <controls:ArtImage Grid.Row="0" Grid.Column="1" Url="{x:Bind Thumb2}" CornerRadius="3" DecodeWidth="320" />
                        <controls:ArtImage Grid.Row="1" Grid.Column="0" Url="{x:Bind Thumb3}" CornerRadius="3" DecodeWidth="320" />
                        <controls:ArtImage Grid.Row="1" Grid.Column="1" Url="{x:Bind Thumb4}" CornerRadius="3" DecodeWidth="320" />
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Overall reviews:" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ReviewLabel}" Foreground="{x:Bind ReviewBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl Grid.Row="3"
                                  ItemsSource="{x:Bind Genres}"
                                  ItemTemplate="{StaticResource GenreChipTemplate}"
                                  Style="{StaticResource InlineChipsStyle}" />
                    <Grid Grid.Row="4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F8;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind PlatformsText}" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:PriceBlock HorizontalAlignment="Right" Price="{x:Bind Price}" FallbackText="{x:Bind PriceFallback}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- FEATURED & RECOMMENDED, compact: full-width capsule with name + price overlay. -->
        <DataTemplate x:Key="HeroCompactTemplate" x:DataType="vm:StoreItemVM">
            <Grid CornerRadius="6" Background="{StaticResource SurfaceBrush}">
                <controls:ArtImage Url="{x:Bind Capsule}" PlaceholderText="{x:Bind Name}" DecodeWidth="800" />
                <Border Background="{StaticResource CardScrimBrush}" />
                <Grid VerticalAlignment="Bottom" Padding="14,0,14,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextTitleBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                    <controls:PriceBlock Grid.Column="1" Price="{x:Bind Price}" FallbackText="{x:Bind PriceFallback}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Shelf card: header art, name, offer/release line, price block. -->
        <DataTemplate x:Key="StoreCardTemplate" x:DataType="vm:StoreItemVM">
            <controls:CardButton Width="292" Click="OnStoreItemClick" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="{x:Bind Name}">
                <StackPanel>
                    <controls:ArtImage Height="137" Url="{x:Bind Header}" PlaceholderText="{x:Bind Name}" CornerRadius="6,6,0,0" DecodeWidth="460" />
                    <Grid Padding="12,10,12,12" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Subline}" Style="{StaticResource MetaTextStyle}" />
                        <controls:PriceBlock Grid.Row="2" Margin="0,6,0,0" HorizontalAlignment="Right" Price="{x:Bind Price}" FallbackText="{x:Bind PriceFallback}" />
                    </Grid>
                </StackPanel>
            </controls:CardButton>
        </DataTemplate>

        <!-- TOP SELLERS row. -->
        <DataTemplate x:Key="TopSellerRowTemplate" x:DataType="vm:StoreItemVM">
            <controls:CardButton HorizontalAlignment="Stretch" Click="OnStoreItemClick" Style="{StaticResource RowButtonStyle}" AutomationProperties.Name="{x:Bind Name}">
                <Grid Height="78" ColumnSpacing="16" Padding="0,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:ArtImage Width="207" Url="{x:Bind SmallCapsule}" PlaceholderText="{x:Bind Name}" CornerRadius="4,0,0,4" DecodeWidth="231" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind ReviewBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ReviewLabel}" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7F8;" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{x:Bind PlatformsText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <controls:PriceBlock Grid.Column="2" Price="{x:Bind Price}" FallbackText="{x:Bind PriceFallback}" />
                </Grid>
            </controls:CardButton>
        </DataTemplate>

        <!-- MOST PLAYED ranked row. -->
        <DataTemplate x:Key="MostPlayedRowTemplate" x:DataType="vm:ChartEntryVM">
            <controls:CardButton HorizontalAlignment="Stretch" Click="OnChartClick" Style="{StaticResource RowButtonStyle}" AutomationProperties.Name="{x:Bind Name}">
                <Grid Height="68" ColumnSpacing="14" Padding="12,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Rank}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <controls:ArtImage Grid.Column="1" Width="120" Height="56" Url="{x:Bind Header}" PlaceholderText="{x:Bind Name}" CornerRadius="3" DecodeWidth="240" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource StatusInGameBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind PlayersLabel}" FontSize="12" Foreground="{StaticResource StatusInGameBrush}" />
                            <TextBlock Text="·" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{x:Bind PeakLabel}" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <controls:PriceBlock Grid.Column="3" Price="{x:Bind Price}" FallbackText="See store" />
                </Grid>
            </controls:CardButton>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource StoreBackgroundBrush}">
        <ScrollViewer x:Name="PageScroller" Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel x:Name="ContentColumn" MaxWidth="1600" Padding="32,20,32,40" Spacing="32" XYFocusKeyboardNavigation="Enabled">

                <!-- 1. Search + popular tags -->
                <Grid x:Name="SearchRow" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SearchColumn" Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <AutoSuggestBox x:Name="SearchBox"
                                    PlaceholderText="Search the store"
                                    QueryIcon="Find"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Search the store"
                                    TextChanged="OnSearchTextChanged"
                                    QuerySubmitted="OnSearchQuerySubmitted"
                                    SuggestionChosen="OnSearchSuggestionChosen" />
                    <ItemsControl x:Name="TagsShelf"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  ItemsSource="{x:Bind Tags}"
                                  ItemTemplate="{StaticResource TagChipTemplate}"
                                  Style="{StaticResource ChipShelfStyle}" />
                </Grid>

                <!-- 2. Featured & recommended -->
                <StackPanel Spacing="12">
                    <controls:SectionHeader Title="Featured &amp; Recommended" />
                    <FlipView x:Name="HeroFlip"
                              Height="380"
                              CornerRadius="6"
                              Background="Transparent"
                              ItemsSource="{x:Bind Featured}"
                              ItemTemplate="{StaticResource HeroWideTemplate}"
                              AutomationProperties.Name="Featured and recommended"
                              UseSystemFocusVisuals="True"
                              FocusVisualPrimaryBrush="{StaticResource FocusRingBrush}"
                              FocusVisualPrimaryThickness="2"
                              FocusVisualSecondaryBrush="{StaticResource AccentBrush}"
                              FocusVisualSecondaryThickness="2"
                              FocusVisualMargin="-4"
                              Tapped="OnHeroTapped"
                              KeyDown="OnHeroKeyDown"
                              PointerEntered="OnHeroPointerEntered"
                              PointerExited="OnHeroPointerExited"
                              GotFocus="OnHeroGotFocus"
                              LostFocus="OnHeroLostFocus" />
                    <PipsPager x:Name="HeroPips"
                               HorizontalAlignment="Center"
                               MaxVisiblePips="12"
                               IsTabStop="False"
                               NumberOfPages="{x:Bind FeaturedCount}"
                               SelectedPageIndex="{x:Bind HeroFlip.SelectedIndex, Mode=TwoWay}" />
                </StackPanel>

                <!-- 3. Special offers -->
                <StackPanel Spacing="12">
                    <controls:SectionHeader Title="Special Offers" Trailing="Browse more ›" />
                    <ItemsControl ItemsSource="{x:Bind Specials}" ItemTemplate="{StaticResource StoreCardTemplate}" Style="{StaticResource ShelfStyle}" />
                </StackPanel>

                <!-- 4. Top sellers -->
                <StackPanel Spacing="12">
                    <controls:SectionHeader Title="Top Sellers" Trailing="See all ›" />
                    <ItemsRepeater ItemsSource="{x:Bind TopSellers}" ItemTemplate="{StaticResource TopSellerRowTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="TopSellersLayout"
                                               MinItemWidth="420"
                                               MinItemHeight="78"
                                               MinColumnSpacing="12"
                                               MinRowSpacing="8"
                                               MaximumRowsOrColumns="2"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <!-- 5. New & trending -->
                <StackPanel Spacing="12">
                    <controls:SectionHeader Title="New &amp; Trending" Trailing="See all ›" />
                    <ItemsControl ItemsSource="{x:Bind NewReleases}" ItemTemplate="{StaticResource StoreCardTemplate}" Style="{StaticResource ShelfStyle}" />
                </StackPanel>

                <!-- 6. Most played -->
                <StackPanel Spacing="12">
                    <controls:SectionHeader Title="Most Played" Trailing="Live charts ›" />
                    <ItemsRepeater ItemsSource="{x:Bind MostPlayed}" ItemTemplate="{StaticResource MostPlayedRowTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="MostPlayedLayout"
                                               MinItemWidth="420"
                                               MinItemHeight="68"
                                               MinColumnSpacing="12"
                                               MinRowSpacing="8"
                                               MaximumRowsOrColumns="2"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <!-- 7. Popular upcoming -->
                <StackPanel Spacing="12">
                    <controls:SectionHeader Title="Popular Upcoming" Trailing="See all ›" />
                    <ItemsControl ItemsSource="{x:Bind ComingSoon}" ItemTemplate="{StaticResource StoreCardTemplate}" Style="{StaticResource ShelfStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
