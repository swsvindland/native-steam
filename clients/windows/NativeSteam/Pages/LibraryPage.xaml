<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NativeSteam.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NativeSteam.Controls"
    xmlns:vm="using:NativeSteam.ViewModels"
    NavigationCacheMode="Required"
    Foreground="{StaticResource TextBodyBrush}">

    <Page.Resources>
        <!-- Sidebar collection row -->
        <DataTemplate x:Key="CollectionRowTemplate" x:DataType="vm:CollectionVM">
            <Grid ColumnSpacing="12" Padding="2,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind CountLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Compact / medium collection chip -->
        <DataTemplate x:Key="CollectionChipTemplate" x:DataType="vm:CollectionVM">
            <Button Style="{StaticResource ChipButtonStyle}"
                    Background="{x:Bind ChipBackground, Mode=OneWay}"
                    Foreground="{x:Bind ChipForeground, Mode=OneWay}"
                    Click="OnCollectionChipClick"
                    AutomationProperties.Name="{x:Bind Name}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Name}" />
                    <TextBlock Text="{x:Bind CountLabel}" Opacity="0.7" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- RECENT GAMES: hero art + logo, last played beneath. -->
        <DataTemplate x:Key="RecentGameTemplate" x:DataType="vm:LibraryGameVM">
            <controls:CardButton Width="{x:Bind CardWidth}" Click="OnGameClick" Background="{StaticResource SurfaceNeutralBrush}" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="{x:Bind Name}">
                <StackPanel>
                    <Grid Height="190">
                        <controls:ArtImage Url="{x:Bind Hero}" PlaceholderText="{x:Bind Name}" CornerRadius="6,6,0,0" DecodeWidth="900" />
                        <Border Background="{StaticResource CardScrimBrush}" CornerRadius="6,6,0,0" />
                        <controls:ArtImage Height="72"
                                           Margin="16,0,48,14"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Bottom"
                                           Url="{x:Bind Logo}"
                                           Stretch="Uniform"
                                           ImageAlignmentX="Left"
                                           ImageAlignmentY="Bottom"
                                           ShowPlaceholder="False"
                                           DecodeWidth="520"
                                           Visibility="{x:Bind LogoVisibility}" />
                        <TextBlock Margin="16,0,16,14"
                                   VerticalAlignment="Bottom"
                                   Text="{x:Bind Name}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTitleBrush}"
                                   Visibility="{x:Bind NameFallbackVisibility}" />
                        <Border Width="10" Height="10" Margin="0,12,12,0" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="5" Background="{StaticResource AccentBrush}" Visibility="{x:Bind UpdateVisibility}" />
                    </Grid>
                    <Grid Padding="14,10,14,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind LastPlayedLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextTitleBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind PlaytimeLabel}" Style="{StaticResource MetaTextStyle}" />
                    </Grid>
                </StackPanel>
            </controls:CardButton>
        </DataTemplate>

        <!-- ALL GAMES portrait cover. -->
        <DataTemplate x:Key="PortraitTemplate" x:DataType="vm:LibraryGameVM">
            <controls:CardButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnGameClick" Background="{StaticResource SurfaceNeutralBrush}" Style="{StaticResource CardButtonStyle}" AutomationProperties.Name="{x:Bind Name}">
                <controls:OverlayPanel>
                    <controls:ArtImage Url="{x:Bind Portrait}" PlaceholderText="{x:Bind Name}" CornerRadius="6" DecodeWidth="300" Opacity="{x:Bind CoverOpacity}" />
                    <!-- Badges -->
                    <Border Margin="8" Padding="5,4,5,4" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" Background="#B3000000" Visibility="{x:Bind FavoriteVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="#FFFFC82C" />
                    </Border>
                    <Border Width="10" Height="10" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="5" Background="{StaticResource AccentBrush}" BorderBrush="#CC000000" BorderThickness="1" Visibility="{x:Bind UpdateVisibility}" />
                    <Border Margin="8" Padding="5,4,5,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="4" Background="#B3000000" Visibility="{x:Bind NotInstalledVisibility}">
                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource TextBodyBrush}" />
                    </Border>
                    <!-- Name revealed on hover / focus (CardButton toggles elements named "Reveal"). -->
                    <Grid x:Name="Reveal" Opacity="0" VerticalAlignment="Bottom" CornerRadius="0,0,6,6" Padding="10,24,10,10" IsHitTestVisible="False">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#E6000000" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.12" />
                        </Grid.OpacityTransition>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextTitleBrush}" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind StatusLine}" FontSize="11" Foreground="{StaticResource TextBodyBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </controls:OverlayPanel>
            </controls:CardButton>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource LibraryBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Collections sidebar (≥ 1000 epx): dynamic collections, then the user's own. -->
        <Grid x:Name="Sidebar" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" XYFocusKeyboardNavigation="Enabled">
            <Grid.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF2A475E" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF325673" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FF2A475E" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14FFFFFF" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="ListViewItemForeground" Color="#FFC7D5E0" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="FilterBox"
                     Margin="12,16,12,8"
                     PlaceholderText="Search your library"
                     TextChanged="OnFilterTextChanged"
                     AutomationProperties.Name="Filter games by name" />
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}">
                <StackPanel Padding="0,4,0,12">
                    <TextBlock Margin="18,10,12,6" Text="LIBRARY" Style="{StaticResource CaptionTextStyle}" />
                    <ListView x:Name="DynamicList"
                              Padding="4,0,4,0"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ItemsSource="{x:Bind DynamicCollections}"
                              ItemTemplate="{StaticResource CollectionRowTemplate}"
                              SelectionChanged="OnCollectionSelectionChanged"
                              AutomationProperties.Name="Library" />
                    <TextBlock Margin="18,18,12,6" Text="COLLECTIONS" Style="{StaticResource CaptionTextStyle}" />
                    <ListView x:Name="UserList"
                              Padding="4,0,4,0"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ItemsSource="{x:Bind UserCollections}"
                              ItemTemplate="{StaticResource CollectionRowTemplate}"
                              SelectionChanged="OnCollectionSelectionChanged"
                              AutomationProperties.Name="Collections" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Padding="16,12,16,16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind InstalledSummary}" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer x:Name="PageScroller" Grid.Column="1" Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel x:Name="ContentColumn" MaxWidth="1600" Padding="32,20,32,40" Spacing="28" XYFocusKeyboardNavigation="Enabled">

                <!-- Collection chips (compact / medium) -->
                <ItemsControl x:Name="CollectionChips"
                              Visibility="Collapsed"
                              ItemsSource="{x:Bind Collections}"
                              ItemTemplate="{StaticResource CollectionChipTemplate}"
                              Style="{StaticResource ChipShelfStyle}" />

                <!-- Recent games -->
                <StackPanel x:Name="RecentSection" Spacing="12">
                    <controls:SectionHeader Title="Recent Games" />
                    <ItemsControl x:Name="RecentShelf" ItemsSource="{x:Bind Recent}" ItemTemplate="{StaticResource RecentGameTemplate}" Style="{StaticResource ShelfStyle}" />
                </StackPanel>

                <!-- All games -->
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:SectionHeader x:Name="AllGamesHeader" Title="All Games" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Padding="2" CornerRadius="5" Background="#33000000" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="SortAlphaButton" Tag="0" Content="Alphabetical" Style="{StaticResource SegmentButtonStyle}" Click="OnSortClick" />
                                <Button x:Name="SortRecentButton" Tag="1" Content="Recently played" Style="{StaticResource SegmentButtonStyle}" Click="OnSortClick" />
                                <Button x:Name="SortHoursButton" Tag="2" Content="Hours played" Style="{StaticResource SegmentButtonStyle}" Click="OnSortClick" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ItemsRepeater x:Name="GamesRepeater" ItemTemplate="{StaticResource PortraitTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="GamesLayout"
                                               MinItemWidth="168"
                                               MinItemHeight="252"
                                               MinColumnSpacing="16"
                                               MinRowSpacing="18"
                                               ItemsStretch="Uniform" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Text="No games match this filter." Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
